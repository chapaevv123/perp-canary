{
  "name": "perp-canary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node --experimental-strip-types src/cli.ts snapshot",
    "verify": "node --experimental-strip-types src/cli.ts verify",
    "serve": "node --experimental-strip-types src/server.ts",
    "bot": "node --experimental-strip-types src/bot-cli.ts",
    "bot-unlock-check": "node --experimental-strip-types src/bot-cli.ts unlock",
    "bot-execute": "node --experimental-strip-types src/execute-bot-cli.ts",
    "canary-prepare": "node --experimental-strip-types src/prepare-post-only-cli.ts",
    "canary-price": "node --experimental-strip-types src/first-proof-cli.ts price",
    "canary-first-proof": "node --experimental-strip-types src/first-proof-cli.ts first-proof",
    "canary-status": "node --experimental-strip-types src/first-proof-status-cli.ts",
    "canary-proof": "node --experimental-strip-types src/canary-proof-cli.ts",
    "canary-verify": "node --experimental-strip-types src/canary-verify-cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts test/preflight-compare.test.mjs test/m7-browser-logic.test.mjs test/m8-intelligence.test.mjs",
    "test:ui": "node --test test/ui-browser.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build-release.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.32.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "24.19.2",
    "eslint": "^9.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
